      "isDeleted": false,
      "boundElements": null,
      "updated": 1789755396105,
      "created": 1789755396035,
      "link": null,
      "locked": false,
      "text": "Architecture illustration. Separate screenshots show actual live checks and recorded revocation evidence.",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Architecture illustration. Separate screenshots show actual live checks and recorded revocation evidence.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZxDyviZxahX5DwSMAKxN7",
      "type": "text",
      "x": 129.75199999999998,
      "y": 617.5,
      "width": 344.49600000000004,
      "height": 125,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4V",
      "roundness": null,
      "seed": 2091399021,
      "version": 5,
      "versionNonce": 1699559665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789755396105,
      "created": 1789755396035,
      "link": null,
      "locked": false,
      "text": "Credential boundary\n\nOpenShell holds the runtime key.\nAgent Handler holds Workday OAuth.\nNo raw Workday or runtime key\nin the sandbox.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "wn8AVdhi_Ml_93YzpMhIB",
      "originalText": "Credential boundary\n\nOpenShell holds the runtime key.\nAgent Handler holds Workday OAuth.\nThe sandbox has no raw secrets.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YNq1YbA7udSSK4AINfqIk",
      "type": "text",
      "x": 587.364,
      "y": 617.5,
      "width": 317.272,
      "height": 125,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5V",
      "roundness": null,
      "seed": 1793638861,
      "version": 5,
      "versionNonce": 1274268319,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789755396105,
      "created": 1789755396035,
      "link": null,
      "locked": false,
      "text": "Role and key checks\n\nRuntime key: 1 pack + 1 user.\nOther pack: explicit scope denial.\nRevoked key: HTTP 403.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Uu5PDgeXRvTcImEYsAg-Q",
      "originalText": "Role and key checks\n\nRuntime key: 1 pack + 1 user.\nOther pack: explicit scope denial.\nRevoked key: HTTP 403.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Woun4nxAc4U3n9io35zgc",
      "type": "text",
      "x": 1024.3919999999998,
      "y": 605,
      "width": 331.2160000000001,
      "height": 150,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6V",
      "roundness": null,
      "seed": 694747181,
      "version": 5,
      "versionNonce": 1979380433,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789755396105,
      "created": 1789755396035,
      "link": null,
      "locked": false,
      "text": "Evidence limits\n\nPermitted results reach inference.\nNo record-isolation or universal\nexfiltration-prevention claim.\nOAuth grants not introspected.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "GhGUDQue52KWVlhuT7WcR",
      "originalText": "Evidence limits\n\nPermitted results reach inference.\nNo record-isolation or universal\nexfiltration-prevention claim.\nOAuth grants not introspected.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
