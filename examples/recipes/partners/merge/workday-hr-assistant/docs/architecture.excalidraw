    {
      "id": "2OH25oFKkk_fN-zoDJFj8",
      "type": "text",
      "x": 92,
      "y": 839,
      "width": 902.566799999999,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#343a40",
